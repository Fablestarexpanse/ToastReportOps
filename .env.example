# Toast Report Workstation — configuration template
# Copy to .env and fill in. .env is git-ignored; never commit secrets.
# Every service reads config from environment only (pydantic-settings).

# NOTE: docker env_file does NOT support inline comments — everything after `=`
# becomes the value. Keep comments on their own lines.

# ---- core paths (no hardcoded paths anywhere else) ----
# toast.db, raw/ CAS, pmtiles/
TOAST_DATA_DIR=./data
TOAST_DB_PATH=./data/toast.db

# ---- LLM (OpenAI-compatible local endpoint; swap models freely) ----
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:14b
# required by some clients; dummy value for Ollama
LLM_API_KEY=unused-for-local

# ---- embeddings ----
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# ---- operator API / UI (localhost by default) ----
API_BIND=127.0.0.1
API_PORT=8400
OPERATOR_UI_PORT=8401
# Only if ever exposed beyond localhost:
# OPERATOR_PASSWORD_HASH=
# SESSION_SECRET=

# ---- ingest keys (all free tiers) ----
# register free at https://firms.modaps.eosdis.nasa.gov/api/
FIRMS_MAP_KEY=

# ---- active research layer (Local Deep Research) ----
# service-account credentials for the LDR container (created on first use)
LDR_URL=http://ldr:5000
LDR_USERNAME=toast-operator
LDR_PASSWORD=toast-local-research-2026

# ---- social publishing: Bluesky (easiest — app password, no review) ----
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# ---- map/environment layers (optional; see docs/API-KEYS.md) ----
AIRNOW_API_KEY=

# ---- publishing: social only ----
# The newsroom does NOT push to any website; you publish to your own
# site by hand (NEWSROOM -> COPY / EXPORT).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
FB_PAGE_ID=
FB_PAGE_TOKEN=
EMAIL_SENDER_API_KEY=
DISCORD_WEBHOOK_URL=

# ---- backups (B2) ----
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=

# ---- logging ----
LOG_LEVEL=INFO
