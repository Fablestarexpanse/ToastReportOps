# Toast Report Workstation — configuration template
# Copy to .env and fill in. .env is git-ignored; never commit secrets.
# Every service reads config from environment only (pydantic-settings).

# ---- core paths (no hardcoded paths anywhere else) ----
TOAST_DATA_DIR=./data                # toast.db, raw/ CAS, pmtiles/
TOAST_DB_PATH=./data/toast.db

# ---- LLM (OpenAI-compatible local endpoint; swap models freely) ----
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3
LLM_API_KEY=unused-for-local         # required by some clients; dummy for Ollama

# ---- embeddings ----
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# ---- operator API / UI (localhost by default) ----
API_BIND=127.0.0.1
API_PORT=8400
OPERATOR_UI_PORT=8401
# Only if ever exposed beyond localhost:
# OPERATOR_PASSWORD_HASH=
# SESSION_SECRET=

# ---- ingest keys (all free tiers) ----
FIRMS_MAP_KEY=                       # https://firms.modaps.eosdis.nasa.gov/api/

# ---- publishing (Phase 4; leave empty until then) ----
CF_PAGES_PROJECT=
CLOUDFLARE_API_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
FB_PAGE_ID=
FB_PAGE_TOKEN=
EMAIL_SENDER_API_KEY=
DISCORD_WEBHOOK_URL=

# ---- backups (B2) ----
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=

# ---- logging ----
LOG_LEVEL=INFO
