# Toast Report Workstation — configuration template
# Copy to .env and fill in. .env is git-ignored; never commit secrets.
# Every service reads config from environment only (pydantic-settings).

# NOTE: docker env_file does NOT support inline comments — everything after `=`
# becomes the value. Keep comments on their own lines.

# ---- core paths (no hardcoded paths anywhere else) ----
# toast.db, raw/ CAS, pmtiles/
TOAST_DATA_DIR=./data
TOAST_DB_PATH=./data/toast.db

# ---- LLM (OpenAI-compatible local endpoint; swap models freely) ----
# Served by the in-stack `llm` container (Ollama). If you run Ollama on the
# host instead, point this back at http://localhost:11434/v1.
LLM_BASE_URL=http://llm:11434/v1
# The default is the official Qwen3.5 9B from the Ollama library, whose download is
# digest-pinned and verified by "Install Models.cmd" (docs/MODELS.md). Models from
# community uploaders (hf.co/<user>/<repo>) are NOT verified by the installer and
# carry unreviewed weights and chat templates — use them only on purpose.
# NOTE: the operator UI stores its own `llm_model` in app_settings, and THAT
# OVERRIDES this value — change both, or editing .env alone appears to do nothing.
LLM_MODEL=qwen3.5:9b
LLM_TIMEOUT_S=120
LLM_NO_THINK_TOKEN=/no_think  # qwen3 reasoning suppression; a no-op on models without it
# How "no thinking" is requested: soft (the token above) or native (Ollama's own
# think:false, which Qwen3.5 and Gemma 4 honour). Check which works for your model:
#   docker compose --profile desktop exec -T api python -m toast.eval.model_bakeoff probe
LLM_THINK_MODE=soft
# required by some clients; dummy value for Ollama
LLM_API_KEY=unused-for-local

# ---- embeddings ----
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# ---- in-stack llm container (docker-compose.yml `llm` service) ----
# Where Ollama stores models. Defaults to the `ollama_models` named volume;
# point at an existing host cache to avoid re-downloading.
# OLLAMA_MODELS_DIR=F:/path/to/ollama/models
# The llm container downloads nothing by itself: run "Install Models.cmd" (verified,
# pinned). LLM_AUTO_PULL=1 restores an UNVERIFIED pull of the two models below on boot.
# LLM_AUTO_PULL=0
# Models the llm container pulls on boot when LLM_AUTO_PULL=1.
# Qwen3.5 ('qwen35') needs Ollama >= 0.32 — older builds fail to load it with
# "unknown model architecture". The compose image is :latest, so `docker compose
# pull llm` is the fix if you hit that.
# LLM_PULL_MODEL=qwen3.5:9b
# LLM_EMBED_PULL_MODEL=nomic-embed-text

# ---- operator API / UI (localhost by default) ----
API_BIND=127.0.0.1
API_PORT=8400
HEALTH_PORT=8410              # worker/scheduler /healthz
# Where the operator UI looks for the API. THE knob for the desktop -> server
# move that OPERATIONS.md promises is config-only. Read by operator-ui/next.config.ts.
TOAST_API_URL=http://127.0.0.1:8400
# The UI's own port is set by whatever starts it: scripts/launch.ps1 uses 3005,
# .claude/launch.json uses 3000. There is no env var for it — don't add one here
# expecting it to be read.
# Only if ever exposed beyond localhost:
# OPERATOR_PASSWORD_HASH=
# SESSION_SECRET=

# ---- ingest keys (all free tiers) ----
# register free at https://firms.modaps.eosdis.nasa.gov/api/
FIRMS_MAP_KEY=

# ---- active research layer (Local Deep Research) ----
# service-account credentials for the LDR container (created on first use)
LDR_URL=http://ldr:5000
LDR_USERNAME=toast-operator
LDR_PASSWORD=toast-local-research-2026

# ---- social publishing: Bluesky (easiest — app password, no review) ----
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# ---- map/environment layers (optional; see docs/API-KEYS.md) ----
AIRNOW_API_KEY=
# MAPTILER_KEY=your-key-here
# OWM_API_KEY=your-key-here

# ---- RADIO: optional Whisper transcription endpoint ----
# Unset = radio clips are archived but not transcribed.
# WHISPER_URL=http://localhost:9000

# ---- RADIO: own live scanner stream (icecast in the stack, port 8100) ----
# rtl_airband on the SDR host publishes to these; defaults are fine for a
# loopback-only stack. See docs/RADIO-SETUP.md "live listening".
# ICECAST_SOURCE_PASSWORD=toast-sdr-source
# ICECAST_ADMIN_PASSWORD=toast-sdr-admin
# ICECAST_RELAY_PASSWORD=toast-sdr-relay

# ---- MESH: Meshtastic public MQTT (defaults shown; the user/pass are the
# broker's published community credentials, not secrets) ----
# MESH_MQTT_HOST=mqtt.meshtastic.org
# MESH_MQTT_USER=meshdev
# MESH_MQTT_PASS=large4cats
# MESH_MQTT_TOPIC=msh/US/#

# ---- publishing: social only ----
# The newsroom does NOT push to any website; you publish to your own
# site by hand (NEWSROOM -> COPY / EXPORT).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
FB_PAGE_ID=
FB_PAGE_TOKEN=
# Telegram: one bot, two rooms — a public channel we publish to, and a private
# ops chat for alerts + approve-from-chat (see docs/API-KEYS.md).
# TELEGRAM_BOT_TOKEN=your-token-here
# TELEGRAM_CHANNEL_ID=@your-channel-or--100id
# TELEGRAM_OPS_CHAT_ID=your-chat-id-here
# Email digest and Discord/webhook publishers are NOT built. These two used to
# sit here looking configurable — filling them in did nothing at all, silently,
# because Settings ignores unknown keys. Re-add them when an adapter exists.
# EMAIL_SENDER_API_KEY=
# DISCORD_WEBHOOK_URL=

# ---- backups (B2) ----
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=

# ---- logging ----
LOG_LEVEL=INFO

# --- queue tuning (rarely changed) ---
WORKER_POLL_INTERVAL_S=1
JOB_BACKOFF_BASE_S=5
